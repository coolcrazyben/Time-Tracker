# ─── Development ────────────────────────────────────────────────────────────
# Set USE_SQLITE=true to use local SQLite instead of Vercel Postgres
USE_SQLITE=true

# Path to the SQLite database file (defaults to ./clock-report.db)
# SQLITE_PATH=./clock-report.db

# ─── Production (Vercel Postgres) ────────────────────────────────────────────
# These are provided automatically when you link a Vercel Postgres database.
# You only need to set them manually for local Postgres testing.
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=
