# ─── Development ────────────────────────────────────────────────────────────
# Set USE_SQLITE=true to use local SQLite instead of Vercel Postgres
USE_SQLITE=true

# Path to the SQLite database file (defaults to ./clock-report.db)
# SQLITE_PATH=./clock-report.db

# ─── Production (Neon / Vercel Postgres) ──────────────────────────────────────
# The app checks DATABASE_URL first, then POSTGRES_URL.
# When you link a Neon database via Vercel Storage, DATABASE_URL is injected automatically.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# POSTGRES_URL=   ← legacy name, also supported
